+РѕР±РѕР№С‚Рё РєСЂСѓРіРѕРІРѕР№ СЃРїРёСЃРѕРє СЌР»РµРјРµРЅС‚РѕРІ Рё РјР°СЃС€С‚Р°Р±РёСЂРѕРІР°С‚СЊ РёС… x/y/w/h РЅР° (W/1024, H/768).
+РћС‚СЂРёСЃРѕРІРєР° Рё hit-test С‡РёС‚Р°СЋС‚ С‚Рµ Р¶Рµ РїРѕР»СЏ -> РѕСЃС‚Р°СЋС‚СЃСЏ СЃРѕРіР»Р°СЃРѕРІР°РЅРЅС‹РјРё, РєРЅРѕРїРєРё Р¶РёРІС‹.
+
+РЎС‚СЂСѓРєС‚СѓСЂР° СЃРїРёСЃРєР° (РІС‹РІРµРґРµРЅР° СЃС‚Р°С‚РёС‡РµСЃРєРё РёР· apply_flag 0x98bd70):
+    mgr  = [0x82b968]
+    head = [mgr]
+    node = [head+8]            ; РєСЂСѓРіРѕРІРѕР№: РєРѕРЅРµС† РєРѕРіРґР° node == head
+    elem = [node+0x1c]
+    flags= [elem+0x14c]
+    X/Y/W/H = [elem+X_OFF] ...  <-- Р—РђРџРћР›РќРРўР¬ РёР· РїСЂРѕС‚РѕРєРѕР»Р° deep_re (Cheat Engine)
+
+РџР°СЂР°РјРµС‚СЂС‹ РЅРёР¶Рµ вЂ” Р·Р°РіР»СѓС€РєРё РґРѕ РїРѕР»СѓС‡РµРЅРёСЏ runtime-РґР°РЅРЅС‹С…. РЎРєСЂРёРїС‚ РіРµРЅРµСЂРёСЂСѓРµС‚ Р±Р°Р№С‚С‹
+С‚СЂР°РјРїР»РёРЅР° Рё РїРµС‡Р°С‚Р°РµС‚ РёС…; С‚РѕС‡РєР° РІСЃС‚Р°РІРєРё С„РёРЅР°Р»РёР·РёСЂСѓРµС‚СЃСЏ РїРѕСЃР»Рµ С€Р°РіР° 1 РїСЂРѕС‚РѕРєРѕР»Р°.
+"""
+X_OFF = None   # <- offset РїРѕР»СЏ X  РІ РѕР±СЉРµРєС‚Рµ СЌР»РµРјРµРЅС‚Р° (РёР· CE)
+Y_OFF = None   # <- offset РїРѕР»СЏ Y
+W_OFF = None   # <- offset РїРѕР»СЏ W (РµСЃР»Рё РјР°СЃС€С‚Р°Р±РёСЂСѓРµС‚СЃСЏ)
+H_OFF = None   # <- offset РїРѕР»СЏ H (РµСЃР»Рё РјР°СЃС€С‚Р°Р±РёСЂСѓРµС‚СЃСЏ)
+BASE_W, BASE_H = 1024, 768
+MGR   = 0x82b968
+
+def asm_post_scale():
+    """РџСЃРµРІРґРѕ->Р±Р°Р№С‚С‹ РЅРµ РіРµРЅРµСЂРёСЂСѓРµРј РІСЃР»РµРїСѓСЋ: РІРѕР·РІСЂР°С‰Р°РµРј РїР»Р°РЅ РёРЅСЃС‚СЂСѓРєС†РёР№ РґР»СЏ СЂСѓС‡РЅРѕР№
+    СЃР±РѕСЂРєРё РІ code cave, С‡С‚РѕР±С‹ РЅРµ РіР°РґР°С‚СЊ encoding РґРѕ РїРѕР»СѓС‡РµРЅРёСЏ offsets."""
+    plan = [
+        f"mov  eax,[{MGR:#x}]        ; mgr",
+        "mov  eax,[eax]              ; head",
+        "mov  esi,[eax+8]            ; node = head->next",
+        "loop:",
+        "cmp  esi,eax                ; node==head -> РєРѕРЅРµС†",
+        "je   done",
+        "mov  edi,[esi+0x1c]         ; elem",
+        # X' = X * W / 1024
+        f"mov  ecx,[edi+{X_OFF}]      ; X",
+        "imul ecx,[curW]",
+        "mov  ebx,1024", "cdq", "idiv ebx",
+        f"mov  [edi+{X_OFF}],eax",
+        # Y' = Y * H / 768
+        f"mov  ecx,[edi+{Y_OFF}]      ; Y",
+        "imul ecx,[curH]",
+        "mov  ebx,768", "cdq", "idiv ebx",
+        f"mov  [edi+{Y_OFF}],eax",
+        "mov  esi,[esi+8]             ; node = node->next",
+        "jmp  loop",
+        "done:",
+    ]
+    return plan
+
+if __name__ == "__main__":
+    if X_OFF is None or Y_OFF is None:
+        print("hook_skeleton: offsets РЅРµ Р·Р°РїРѕР»РЅРµРЅС‹.")
+        print("РЎРЅР°С‡Р°Р»Р° РІС‹РїРѕР»РЅРёС‚Рµ work/deep_re_protocol.md (С€Р°Рі 1, Cheat Engine)")
+        print("Рё РїСЂРёС€Р»РёС‚Рµ: Р°РґСЂРµСЃ РёРЅСЃС‚СЂСѓРєС†РёРё-Р·Р°РїРёСЃРё, РµС‘ Р±Р°Р№С‚С‹, offset РїРѕР»СЏ X/Y,")
+        print("Р·РЅР°С‡РµРЅРёСЏ СЂРµРіРёСЃС‚СЂРѕРІ РІ РјРѕРјРµРЅС‚ Р·Р°РїРёСЃРё.")
+        print("\nРџР»Р°РЅ С‚СЂР°РјРїР»РёРЅР° (Р±СѓРґРµС‚ СЃРѕР±СЂР°РЅ РїРѕСЃР»Рµ РїРѕР»СѓС‡РµРЅРёСЏ offsets):")
+        for l in asm_post_scale():
+            print("   ", l)
+    else:
+        print("offsets Р·Р°РґР°РЅС‹ вЂ” СЃРѕР±РёСЂР°РµРј Etherlords_native_v2.exe (TODO: encoding)")
