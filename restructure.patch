+"""
+!!! Р’РќРРњРђРќРР•: v1 Р”РђРЃРў Р Р•Р“Р Р•РЎРЎРР® (РјС‘СЂС‚РІС‹Рµ РєРЅРѕРїРєРё). РќРµ РїСЂРёРјРµРЅСЏС‚СЊ.
+!!! РћСЃС‚Р°РІР»РµРЅ РєР°Рє СЂР°Р·Р±РѕСЂ РѕС€РёР±РєРё: РїРѕРґРјРµРЅР° rect СЂР°СЃСЃРёРЅС…СЂРѕРЅРёР·РёСЂСѓРµС‚ hit-test Рё baked-С‚Р°Р±Р»РёС†Сѓ.
+!!! РЎРј. docs/06_hit_test_model.md Рё docs/07_native_v1_regression.md.
+import struct
+SRC="Etherlords.exe"; DST="Etherlords_native.exe"
+data=bytearray(open(SRC,"rb").read())
+VA2F=lambda va: va-0x800000
+CAVE=0xb55656
+def put(va, bs):
+    f=VA2F(va); data[f:f+len(bs)]=bs
+
+# --- B: РЅРµРёР·РІРµСЃС‚РЅРѕРµ СЂР°Р·СЂРµС€РµРЅРёРµ -> С„РѕСЂСЃРёСЂСѓРµРј СЂР°СЃРєР»Р°РґРєСѓ flag=1 (jmp РЅР° push 1 @0x99bd4e) ---
+put(0x0099bd4c, b"\xeb\x00")   # jne bd6a -> jmp bd4e  (w==1024, h!=768)
+put(0x0099bd58, b"\xeb\xf4")   # jne bd6a -> jmp bd4e  (w!=800)
+put(0x0099bd5f, b"\xeb\xed")   # jne bd6a -> jmp bd4e  (w==800, h!=600)
+
+# --- A: С‚СЂР°РјРїР»РёРЅ: СЂРµР°Р»СЊРЅС‹Рµ W/H РёР· С†РµРїРѕС‡РєРё СЂРµР¶РёРјР° РІРјРµСЃС‚Рѕ 1024/768 ---
+t  = b"\xa1\xe8\x5d\x82\x00"   # mov eax,[0x825de8]
+t += b"\x8b\x40\x18"           # mov eax,[eax+0x18]
+t += b"\x8b\x50\x14"           # mov edx,[eax+0x14]   (W)
+t += b"\x8b\x48\x18"           # mov ecx,[eax+0x18]   (H)
+t += b"\x89\x4c\x24\x24"       # mov [esp+0x24],ecx
+t += b"\xe9" + struct.pack("<i", 0x0099fcda - (CAVE + len(t) + 5))
+put(CAVE, t)
+
+# --- С…СѓРє РІРµС‚РєРё flag==1 (mov edx,0x400) РЅР° С‚СЂР°РјРїР»РёРЅ ---
+site=0x0099fccd
+put(site, b"\xe9" + struct.pack("<i", CAVE - (site+5)))
+
+open(DST,"wb").write(bytes(data))
+print("wrote", DST, len(data))
