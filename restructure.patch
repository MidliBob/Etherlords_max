+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+patch_layout.py вЂ” Р­РљРЎРџР•Р РРњР•РќРў B РґР»СЏ Etherlords.exe (Р”РµРјРёСѓСЂРіРё, СЂСѓСЃ. 1.07).
+
+Р“РёРїРѕС‚РµР·Р°: Сѓ UI СЂРѕРІРЅРѕ РґРІРµ СЂР°СЃРєР»Р°РґРєРё (С„Р»Р°Рі 0 = 800x600, С„Р»Р°Рі 1 = 1024x768).
+РџСЂРё Р»СЋР±РѕРј РґСЂСѓРіРѕРј СЂР°Р·СЂРµС€РµРЅРёРё РІС‹Р·РѕРІ РІС‹Р±РѕСЂР° СЂР°СЃРєР»Р°РґРєРё РџР РћРџРЈРЎРљРђР•РўРЎРЇ, Рё UI РѕСЃС‚Р°С‘С‚СЃСЏ
+РІ РґРµС„РѕР»С‚Рµ 800x600 (СЌС‚Рѕ Рё РґР°С‘С‚ HUD, РїСЂРёР¶Р°С‚С‹Р№ Рє 800x600, Рё СЃРµСЂС‹Рµ РїРѕР»СЏ).
+
+РџСЂР°РІРєР°: С„РѕСЂСЃРёСЂРѕРІР°С‚СЊ С„Р»Р°Рі=1 (СЂР°СЃРєР»Р°РґРєР° 1024x768) РґР»СЏ Р›Р®Р‘РћР“Рћ СЂР°Р·СЂРµС€РµРЅРёСЏ.
+РўСЂРё РґРІСѓС…Р±Р°Р№С‚РѕРІС‹С… Р·Р°РјРµРЅС‹ jne -> jmp. РћСЂРёРіРёРЅР°Р»СЊРЅС‹Р№ С„Р°Р№Р» РЅРµ С‚СЂРѕРіР°РµС‚СЃСЏ:
+РїРёС€РµС‚СЃСЏ РєРѕРїРёСЏ Etherlords_layout1024.exe.
+
+РСЃРїРѕР»СЊР·РѕРІР°РЅРёРµ:
+    python3 patch_layout.py Etherlords.exe            # РїСЂРёРјРµРЅРёС‚СЊ -> Etherlords_layout1024.exe
+    python3 patch_layout.py Etherlords.exe --check    # С‚РѕР»СЊРєРѕ РїСЂРѕРІРµСЂРёС‚СЊ, С‡С‚Рѕ Р±Р°Р№С‚С‹ СЃРѕРІРїР°РґР°СЋС‚
+"""
+import hashlib, shutil, sys, os
+
+PATCHES = [  # (file_offset, orig_bytes, new_bytes, comment)
+    (0x19bd4c, bytes.fromhex("751c"), bytes.fromhex("eb00"), "jne notknown -> jmp push1   (w==1024 path)"),
+    (0x19bd58, bytes.fromhex("7510"), bytes.fromhex("ebf4"), "jne notknown -> jmp push1   (w!=800 path)"),
+    (0x19bd5f, bytes.fromhex("7509"), bytes.fromhex("ebed"), "jne notknown -> jmp push1   (h!=600 path)"),
+]
+OUT = "Etherlords_layout1024.exe"
+
+def sha(b): return hashlib.sha256(b).hexdigest()
+
+def main():
+    src = sys.argv[1] if len(sys.argv) > 1 else "Etherlords.exe"
+    check = "--check" in sys.argv
+    d = bytearray(open(src, "rb").read())
+    print(f"source : {src}  {len(d)} bytes  sha256={sha(d)[:16]}")
+    ok = True
+    for off, ob, nb, cmt in PATCHES:
+        cur = bytes(d[off:off+len(ob)])
+        good = (cur == ob)
+        ok &= good
+        print(f"  {off:#010x}: have {cur.hex(' ')}  want {ob.hex(' ')}  -> {nb.hex(' ')}  [{'OK' if good else 'MISMATCH'}]  {cmt}")
+    if not ok:
+        print("\nABORT: Р±РёРЅР°СЂСЊ РѕС‚Р»РёС‡Р°РµС‚СЃСЏ РѕС‚ РѕР¶РёРґР°РµРјРѕРіРѕ вЂ” РїР°С‚С‡ РЅРµ РїСЂРёРјРµРЅСЏРµС‚СЃСЏ (Р·Р°С‰РёС‚Р° РѕС‚ С‡СѓР¶РѕРіРѕ Р±РёР»РґР°).")
+        sys.exit(2)
+    if check:
+        print("\nCHECK OK: Р±Р°Р№С‚С‹ СЃРѕРІРїР°РґР°СЋС‚, РїР°С‚С‡ РїСЂРёРјРµРЅРёРј.")
+        return
+    for off, ob, nb, cmt in PATCHES:
+        d[off:off+len(nb)] = nb
+    open(OUT, "wb").write(bytes(d))
+    print(f"\nwrote {OUT}  {len(d)} bytes  sha256={sha(bytes(d))[:16]}")
+    print("Р”Р°Р»РµРµ: СЃРґРµР»Р°Р№С‚Рµ Р±СЌРєР°Рї СЃРІРѕРµРіРѕ Etherlords.exe, РїРѕР»РѕР¶РёС‚Рµ Etherlords_layout1024.exe")
+    print("СЂСЏРґРѕРј РџРћР” РРњР•РќР•Рњ Etherlords.exe (РёР»Рё Р·Р°РјРµРЅРёС‚Рµ РѕСЂРёРіРёРЅР°Р»), Р·Р°РїСѓСЃС‚РёС‚Рµ РїСЂРё 1600x900")
+    print("Рё РїСЂРёС€Р»РёС‚Рµ СЃРєСЂРёРЅС€РѕС‚С‹ РіР»Р°РІРЅРѕРіРѕ РјРµРЅСЋ Рё РіР»РѕР±Р°Р»СЊРЅРѕР№ РєР°СЂС‚С‹.")
+
+if __name__ == "__main__":
+    main()
